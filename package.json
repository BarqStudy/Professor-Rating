{
  "name": "miyar-professor-rating",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build && node tests/browser/google.cjs",
    "test:study-browser": "npm run build && node tests/browser/study.cjs",
    "test:plan-import-browser": "npm run build && node tests/browser/plan-import.cjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "android:debug": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run mobile:sync && cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "0.5.11",
    "nodemailer": "^10.2.1",
    "playwright-core": "1.64.1",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "2.118.0"
  }
}
